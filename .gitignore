# 虛擬環境、快取、log
.venv/
.venv-vlm/
__pycache__/
*.pyc
*.log

# 資料與輸出不進 repo（授權與隱私）：SyRIP、網路圖、娃娃照片、評估結果
dataset/
outputs/
spike_out.jpg

# 模型權重、Hailo 的產出和校正圖不進 repo（RTMO 由 rtmlib 自動下載）
model/*
*.onnx
*.hef
*.har
*.whl
*.deb
hailo/calib/
# YuNet 很小、授權 MIT，保留（這行要放在上面幾行之後才會生效）
!model/face_detection_yunet_2023mar.onnx

# 只留在本機的文件（私有文件放 docs/private/：context、decisions、status）
docs/private/
docs/*.docx
docs/archive/

# 不能公開的素材（例如網路影片）的標註，只在本機評估（見 video_labels.py）
local_video_*.csv

# 介面原型的真資料（娃娃影片剪的片段與燈號；用 demo_ui/export_assets.py 產生）。假資料 demo_ui/sample/ 進 repo
demo_ui/data/
demo_ui/media/
